# PAUSA — credenciais do Firebase
#
# Onde encontrar: Console do Firebase > Configurações do projeto (engrenagem)
# > Seus apps > escolha o app Web > "Configuração do SDK" > Configuração.
#
# O prefixo EXPO_PUBLIC_ é obrigatório: sem ele o Expo não injeta a variável
# no bundle do cliente. Estas chaves NÃO são segredas — quem protege os dados
# são as Security Rules do Firestore.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=seu-projeto
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=seu-projeto.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Atalho de desenvolvimento: pula o cadastro/login (o onboarding ainda aparece uma vez)
# e concede papel de administrador, para abrir /admin sem conta.
# Serve para trabalhar nas telas antes de o projeto Firebase existir.
# Só funciona em modo de desenvolvimento — não afeta build de produção.
EXPO_PUBLIC_AUTH_BYPASS=false
